#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
  chosen {
    zmk,physical-layout = &foostan_corne_6col_layout;
    // zmk,physical-layout = &foostan_corne_5col_layout;
  };
};

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "QWERTY";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |  -  |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '  |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | DQT/ALT |
//                  | ESC/NAV | BKSP | CMD |   | RET | SPC/CODE | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y    &kp U     &kp I     &kp O   &kp P    &kp MINUS
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H    &kp J     &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N    &kp M     &kp COMMA &kp DOT &kp FSLH &mt RALT DQT
                   &lt 2 ESC &kp BSPC &kp LCMD   &kp RET &lt 1 SPACE &kp RALT
                        >;
                };

                code_layer {
                        display-name = "CODE";
// -----------------------------------------------------------------------------------------
// |  !   |  @  |  #  |  $  |  %  |  ^  |   |  7  |  8  |  9  |  *  |  /  |  &  |
// |  (   |  )  |  [  |  ]  |  {  |  }  |   |  4  |  5  |  6  |  =  |  -  |  +  |
// |  <   |  >  |  \  |  |  |  ~  |  `  |   |  1  |  2  |  3  |  0  |  ,  |  .  |
//                  |  &  | BKSP | CMD |   | RET | SPACE | ALT |
                        // Hold the right middle thumb (Space) to access this layer.
                        bindings = <
   &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT &kp CARET   &kp N7 &kp N8 &kp N9 &kp KP_MULTIPLY &kp KP_DIVIDE &kp AMPS
   &kp LPAR  &kp RPAR  &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC    &kp N4 &kp N5 &kp N6 &kp EQUAL       &kp MINUS     &kp PLUS
   &kp LT    &kp GT    &kp BSLH  &kp PIPE  &kp TILDE &kp GRAVE   &kp N1 &kp N2 &kp N3 &kp N0           &kp COMMA     &kp DOT
                   &kp AMPS &kp BSPC &kp LCMD   &kp RET &trans &kp RALT
                        >;
                };

                nav_sys_layer {
                        display-name = "NAV/SYS";
// -----------------------------------------------------------------------------------------
// | BTCLR | BT0 | BT1 | BT2 | BT3 | BT4 |   | DV1 | DV2 | DV3 | DV4 | DV6 | DV7 |
// | PREV  | PLAY| NEXT| VDN | VUP | MUTE|   |  ←  |  ↓   |  ↑  |  →  | DV8 |     |
// | SHOT3 | SHOT4 | B↓ | B↑ | STUDIO |     |      |      |     |     |     |     |
//                  |  TRANS | BKSP | CMD |   | RET | SPACE | ALT |
                        // Hold the left outer thumb (Escape) to access this layer.
                        // Hold NAV, then tap V, to unlock ZMK Studio.
                        // Divvy: Ctrl+1, Ctrl+2, Ctrl+3, Ctrl+4, Ctrl+6, Ctrl+7, Ctrl+8.
                        bindings = <
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LC(N1) &kp LC(N2) &kp LC(N3) &kp LC(N4) &kp LC(N6) &kp LC(N7)
   &kp C_PREV &kp C_PLAY  &kp C_NEXT    &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE     &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp LC(N8) &trans
   &kp LG(LC(LS(N3))) &kp LG(LC(LS(N4))) &kp C_BRIGHTNESS_DEC &kp C_BRIGHTNESS_INC &studio_unlock &trans   &trans &trans &trans &trans &trans &trans
                   &trans &kp BSPC &kp LCMD   &kp RET &kp SPACE &kp RALT
                        >;
                };
        };
};
